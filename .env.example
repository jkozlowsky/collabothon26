# Copy to .env (cp .env.example .env) and adjust.
# Read automatically by docker compose and by the backend (spring.config.import in application.properties).
# Port 5432 is often taken by a local PostgreSQL, hence 5433 by default.
POSTGRES_DB=collabothon
POSTGRES_USER=collabothon
POSTGRES_PASSWORD=collabothon
POSTGRES_PORT=5433
DB_HOST=localhost
DB_PORT=5433
DB_NAME=collabothon
DB_USER=collabothon
DB_PASSWORD=collabothon
