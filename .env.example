# Copy to .env (cp .env.example .env) and replace CHANGE_ME with your own password (keep POSTGRES_PASSWORD and DB_PASSWORD identical).
# Read automatically by docker compose and by the backend (spring.config.import in application.properties).
# Port 5432 is often taken by a local PostgreSQL, hence 5433 by default.
POSTGRES_DB=collabothon
POSTGRES_USER=collabothon
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5433
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=collabothon
DB_USER=collabothon
DB_PASSWORD=CHANGE_ME
# TypeSafe key for the Jev decision model; leave blank to use the rules fallback.
JEV_API_KEY=
