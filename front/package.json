{
  "name": "front",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~58.0.26",
    "expo-asset": "~58.0.21",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@playwright/test": "^1.65.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --localhost",
    "phone": "expo start --tunnel ngrok",
    "android": "expo start --android --localhost",
    "ios": "expo start --ios --localhost",
    "web": "expo start --web --localhost",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "check": "tsc --noEmit && expo lint && jest",
    "e2e": "playwright test"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^react-native-reanimated$": "<rootDir>/jest/reanimated-entry.js",
      "^react-native-reanimated/mock$": "<rootDir>/jest/reanimated.js"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ]
  }
}
