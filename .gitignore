# ---------------------------------------------------------------
# Root .gitignore — wspólne reguły dla całego monorepo.
# Reguły specyficzne dla stacku są w front/.gitignore i back/.gitignore.
# ---------------------------------------------------------------

# IDE
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.swp
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Sekrety / lokalne zmienne środowiskowe (docker-compose czyta .env)
.env
.env.*
!.env.example

# Logi
*.log
logs/

# Claude Code — lokalne ustawienia użytkownika (wspólne settings.json zostają w repo)
.claude/settings.local.json
**/.claude/settings.local.json
CLAUDE.md
