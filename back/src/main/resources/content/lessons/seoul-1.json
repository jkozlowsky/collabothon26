{
  "id": "seoul-1",
  "story": "seoul",
  "title": "The chat that always knows",
  "place": "Yeouido · office chat",
  "topic": "Hype and drawdowns",
  "minutes": 4,
  "xp": 50,
  "concepts": [
    "volatility",
    "drawdown"
  ],
  "steps": [
    {
      "type": "chat",
      "id": "c1",
      "title": "Team chat · 4 people",
      "messages": [
        {
          "from": "Min-jun",
          "text": "Did you see? XYZ is up 40% this week"
        },
        {
          "from": "Soo-ah",
          "text": "My cousin's leading room says it doubles by June"
        },
        {
          "from": "Min-jun",
          "text": "I'm putting my whole bonus in"
        },
        {
          "from": "Ji-woo",
          "me": true,
          "text": "I have ₩10M saved… should I?"
        },
        {
          "from": "Soo-ah",
          "text": "What's there to lose? It only goes up"
        }
      ]
    },
    {
      "type": "text",
      "id": "t1",
      "kicker": "Meet Ji-woo",
      "title": "27 · office worker in Seoul",
      "body": "Ji-woo saved ₩10 million in three years. That is about €6,800. Her team chat says one stock only goes up. Before she decides: what does a big [[volatility|swing]] do to money?"
    },
    {
      "type": "predict",
      "id": "p1",
      "concepts": [
        "volatility"
      ],
      "prompt": "XYZ rose 40% in one week. The next week it fell 40%. Where is Ji-woo's money compared with the start?",
      "input": {
        "kind": "slider",
        "min": -50,
        "max": 50,
        "step": 1,
        "unit": "%"
      },
      "answer": -16,
      "reveal": "₩10M → ₩14M → ₩8.4M. The 40% drop is taken from a bigger amount than the 40% rise was, so the same percent up and down never lands back at zero."
    },
    {
      "type": "text",
      "id": "t1b",
      "title": "Two weeks",
      "body": "Week one: up 40%. ₩10M becomes ₩14M. Week two: down 40%, taken from ₩14M. She ends at ₩8.4M. Down 16%."
    },
    {
      "type": "slider-chart",
      "id": "s1",
      "concepts": [
        "drawdown"
      ],
      "prompt": "After a loss, how much must the price rise just to get back to the start? Find the loss that needs a +100% gain.",
      "model": "drawdownRecovery",
      "params": {
        "loss": {
          "label": "Loss",
          "min": -80,
          "max": 0,
          "step": 5,
          "value": -10,
          "unit": "%"
        }
      },
      "output": {
        "label": "Gain needed to get back",
        "unit": "%"
      },
      "goal": {
        "condition": {
          "of": "output",
          "min": 100,
          "max": 100
        },
        "hint": "Think of losing half the money."
      }
    },
    {
      "type": "text",
      "id": "t2",
      "title": "Losses weigh more than gains",
      "body": "Lose 10%, and you need 11% to get back. Lose half, and you need to double. The deeper the fall, the harder the climb. That is the maths of a [[drawdown]]."
    },
    {
      "type": "quiz",
      "id": "q1",
      "concepts": [
        "volatility"
      ],
      "prompt": "Why doesn't +40% followed by −40% bring Ji-woo back to zero?",
      "options": [
        "The −40% is taken from a bigger amount than the +40% was",
        "The bank charges a fee in between",
        "Prices always fall faster than they rise"
      ],
      "correctIndex": 0,
      "explanation": "₩10M × 1.4 × 0.6 = ₩8.4M. The second percent applies to the new, larger amount, so the same-sized drop removes more won."
    },
    {
      "type": "quiz",
      "id": "q2",
      "concepts": [
        "drawdown"
      ],
      "prompt": "XYZ fell 50%. What rise does it need to get back to its old price?",
      "options": [
        "+50%",
        "+100%",
        "+25%"
      ],
      "correctIndex": 1,
      "explanation": "Half the money has to double to be whole again: ₩5M × 2 = ₩10M."
    },
    {
      "type": "text",
      "id": "t3",
      "kicker": "Your numbers",
      "title": "Your savings account",
      "body": "This is your savings account today: **{savingsBalance}**. A 50% fall would need +100% to get back."
    }
  ],
